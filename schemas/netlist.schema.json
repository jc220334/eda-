{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eda-course:netlist:1",
  "title": "EDA Course Netlist",
  "description": "课程 PCB 编辑器的基础逻辑网表格式",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "components",
    "nets"
  ],
  "properties": {
    "format": {
      "const": "eda-course-netlist"
    },
    "version": {
      "const": 1
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "nets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/net"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "footprint"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "footprint": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "pin"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "pin": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "net": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "connections"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "connections": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/connection"
          }
        }
      }
    }
  }
}
